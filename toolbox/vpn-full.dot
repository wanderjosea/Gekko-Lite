// Enforcement Mode — offline Codex workspace, no Docker socket or target route.
digraph full_vpn {
  rankdir=TB;
  bgcolor="white";
  labelloc="t";
  fontname="DejaVu Sans"; fontsize=20;
  label="Enforcement Mode (default)";
  node  [fontname="DejaVu Sans", fontsize=12, shape=box, style="rounded,filled", color="#334155", fillcolor="#e2e8f0"];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#334155"];

  subgraph cluster_pc {
    label="Codex workspace";
    style="rounded,filled"; fillcolor="#f8fafc"; color="#94a3b8"; fontname="DejaVu Sans"; fontsize=14;

    policy  [label="signed scope + PreToolUse guard", fillcolor="#dbeafe"];
    blocked [label="Docker socket + target egress\nnot available", fillcolor="#fee2e2", color="#ef4444"];

    subgraph cluster_ctr {
      label="local analysis only";
      style="rounded,filled"; fillcolor="#eef2ff"; color="#6366f1"; fontname="DejaVu Sans"; fontsize=12;
      claude [label="Codex (CLI)", fillcolor="#e0e7ff"];
      tools  [label="KB / reports / artifact analysis", fillcolor="#e0e7ff"];
    }

    policy  -> blocked [label="enforces"];
    claude  -> tools [label="drives", style=dashed];
    tools   -> policy [label="local work only"];
  }

  note [shape=note, fillcolor="#fefce8", color="#ca8a04",
        label="Codex has no target route in this mode.\lUse for offline analysis and preparation.\l"];
  { rank=same; blocked; note; }
}
