{
  "description": "User-level Gekko-Lite scope guard; inactive outside Gekko-Lite workspaces.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 ~/.codex/pena-hooks/pena_guard.py hook",
            "timeout": 5,
            "statusMessage": "Validating user-level Gekko-Lite scope"
          }
        ]
      }
    ]
  }
}
