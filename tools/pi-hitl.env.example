# Gekko · pi-hitl — plantilla de config de arranque.
# Copiá este archivo a .gekko-state/pi-hitl.env (gitignoreado) y completá los valores.
# SÓLO knobs NO-secretos. La API key NO va en este archivo.
export GEKKO_LLM_URL="http://<endpoint-host>:8080/v1"   # endpoint OpenAI-compatible del Provider
export GEKKO_PROVIDER="provider"                      # id del provider en models.json (lo crea setup.sh)
export GEKKO_MODEL="<model-id>"                       # id del modelo que sirve el Provider
# El launcher exige GEKKO_LLM_KEY no-vacío (setup.sh lo guarda en .gekko-state/env). Si tu shell ya lo
# exporta (~/.bashrc), omitilo.
# Workspace del engagement (engagements/<nombre>/): sin esto el launcher abre un menú (o falla sin terminal).
# Deriva de él scope, hallazgos y sesiones de Pi. `none` = sin workspace (trabajo genérico).
# export GEKKO_WORKSPACE="<nombre>"
# Sólo aplican con GEKKO_WORKSPACE=none (con un workspace, el workspace gana):
# export GEKKO_SCOPE="/ruta/scope.txt"                # allowlist del broker (default: repo/scope.txt)
# Card HALLAZGOS del panel: ruta al findings.jsonl (sólo con GEKKO_WORKSPACE=none; sin esta variable la card no existe).
# export GEKKO_FINDINGS="/ruta/engagements/<codename>/findings.jsonl"
# export GEKKO_POLICY_MINS=480                        # cuánto duran las técnicas tildadas (min, default 60).
#                                                     480 = 8h: en AGRESIVO no se desmarcan solas durante la sesión.
# Módulo de reportes (visor web de hallazgos de todos los workspaces, http://127.0.0.1:4355/): el launcher lo levanta
# o se acopla al que ya esté. Queda arriba al salir; se apaga con: pkill -f 'findings_web.py serve'
# export GEKKO_REPORT=0                               # no levantarlo ni usarlo
# export GEKKO_REPORT_PORT=4355                       # puerto fijo (un puerto sirve una sola raíz/worktree)
